{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "aulaperto",
    "main": "worker.js",
    "compatibility_date": "2026-09-10",
    "observability": {
        "enabled": true
    },
    "assets": {
        "directory": ".",
        "binding": "ASSETS",
        "run_worker_first": true
    }
}
